{
  "name": "lilypond-mcp",
  "version": "0.1.0",
  "description": "MCP server that engraves GNU LilyPond sources into cropped EPS, PDF, SVG, and PNG assets",
  "type": "module",
  "license": "MIT",
  "author": "Wilfred Springer <wilfred@eastpole.nl>",
  "homepage": "https://github.com/wspringer/lilypond-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wspringer/lilypond-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wspringer/lilypond-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lilypond",
    "music-notation",
    "engraving",
    "sheet-music",
    "claude",
    "claude-code"
  ],
  "bin": {
    "lilypond-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
